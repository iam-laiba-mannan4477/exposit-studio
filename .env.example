# Exposit Studio configuration.
# install.ps1 copies this file to .env. Edit .env, never this file, and never commit or share .env.
# Every line is optional: the defaults below are what the studio uses when a line is missing or empty.

# --- Where the studio listens. Keep 127.0.0.1 so it is reachable from this computer only.
EXPOSIT_HOST=127.0.0.1
EXPOSIT_PORT=8600

# --- Folders (default: .\data and .\models inside the project folder)
# EXPOSIT_DATA=D:\ExpositData
# EXPOSIT_MODELS=

# --- Rendering. 1920x1080 at 30 fps is the default; lower it on a slow machine.
# EXPOSIT_WIDTH=1920
# EXPOSIT_HEIGHT=1080
# EXPOSIT_FPS=30
# EXPOSIT_X264_PRESET=veryfast
# EXPOSIT_X264_CRF=19
# Use your own FFmpeg instead of the copy installed with the Python packages:
# EXPOSIT_FFMPEG=C:\ffmpeg\bin\ffmpeg.exe

# --- AI provider (chosen in Settings inside the studio).
# Only needed for a hosted OpenAI-compatible endpoint or the Anthropic API. Paid providers stay blocked
# until you also raise "Budget for paid services" above $0 in Settings.
EXPOSIT_LLM_API_KEY=
# Seconds a role waits for an answer (default 3600 for the agent bridge, 600 otherwise)
# EXPOSIT_LLM_TIMEOUT=
# Path to the Claude Code command if it is not on PATH (provider "Claude Code command line")
# EXPOSIT_CLAUDE_BIN=claude

# --- Scout (optional, free). Without a token GitHub allows 60 searches an hour.
EXPOSIT_GITHUB_TOKEN=
# Free YouTube Data API key, only for public view counts. Without it the Scout still reads channel feeds.
EXPOSIT_YOUTUBE_API_KEY=

# --- Reference analysis (optional; needs: pip install -r requirements-optional.txt)
# EXPOSIT_WHISPER_MODEL=base.en

# Optional: Blender for 3D shots (install it yourself from blender.org). Leave empty to auto-detect
# C:\Program Files\Blender Foundation\Blender*\blender.exe, then PATH. Without Blender, 3D shots render as 2D.
BLENDER_PATH=
# Abort a Blender render above this memory (MB); the scene then renders in 2D.
BLENDER_MAX_MB=2500
