# Copy to server.env (never commit it).
# Your domain or subdomain; its DNS A record must point at the server's public IP.
EXPOSIT_DOMAIN=studio.example.com
EXPOSIT_USER=me
# A bcrypt hash, not the password itself. Create one with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-long-password'
# and replace every $ in the hash with $$ (Compose otherwise treats $ as a variable).
EXPOSIT_PASSWORD_HASH=
